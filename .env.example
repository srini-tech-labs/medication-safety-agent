# Set to true to run the whole app with no Databricks workspace, profile, or
# credentials at all — the two Databricks-backed calls are replaced with
# offline canned fixtures (see app/services/demo_fixtures.py). Everything
# below this line is unused/ignored when DEMO_MODE=true.
DEMO_MODE=false

# Must match a profile already created via `databricks auth login` and the
# name of your deployed medication-safety-agent Model Serving endpoint.
DATABRICKS_PROFILE=your-databricks-profile
SERVING_ENDPOINT_NAME=medication-safety-agent

# Medication Management CRUD/lookup runs locally in FastAPI (not a Model
# Serving endpoint) — see docs/databricks-endpoint-lifecycle.md. Fill these
# in with your own workspace's SQL warehouse ID and Unity Catalog location.
DATABRICKS_WAREHOUSE_ID=your-sql-warehouse-id
UNITY_CATALOG=healthcare
UNITY_SCHEMA=medication_safety
